# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tests / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/
# Notebooks themselves are tracked (e.g. kaggle_notebook.ipynb is a
# deployment artifact). Only the checkpoint dirs are ignored.

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Secrets / env files
.env
.env.local
.env.*.local

# Logs / temp
*.log
*.tmp

# Defensive (in case anything JS-side ever lands)
node_modules/

# Generated outputs (harness sweep, verifier CSV/parquet dumps, plot exports).
# LDPC matrices under src/codes/data/ are commit-on-purpose and are NOT here.
results/
out/
local_results/
*.parquet
/sweep_*.csv
/check_*.csv
